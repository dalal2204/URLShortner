<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Page - SMShortner</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Roboto', sans-serif;
      background: linear-gradient(135deg, #f8f9fa, #e9ecef);
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #343a40;
    }
    nav {
      width: 100%;
      background: linear-gradient(90deg, #007bff, #0056b3);
      color: #fff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 20px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    nav .logo {
      font-size: 1.8em;
      font-weight: 700;
    }
    nav form {
      margin: 0;
      background: transparent;
      border: none;
      padding: 0;
    }
    .logout-btn {
      background: #fff; 
      color: #04106a;
      border: none;
      padding: 5px 15px;
      font-size: 0.9em;
      border-radius: 30px;
      cursor: pointer;
      font-weight: 500;
      transition: background 0.3s ease, color 0.3s ease;
      outline: none; /* Remove focus outline */
      box-shadow: none; /* Remove any default shadow */
    }
    .logout-btn:hover {
      background: rgba(255, 255, 255, 0.2);
    }
    .container {
      width: 90%;
      max-width: 1000px;
      margin: 40px auto;
      background: #fff;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }
    h1 {
      color: #212529;
      text-align: center;
      margin-bottom: 30px;
      font-size: 2.2em;
    }
    form {
      background: #f1f3f5;
      padding: 25px;
      border-radius: 8px;
      margin-bottom: 30px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    }
    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 500;
    }
    input[type="text"] {
      width: 100%;
      padding: 12px 15px;
      margin-bottom: 15px;
      border: 1px solid #ced4da;
      border-radius: 5px;
      transition: border 0.3s ease;
    }
    input[type="text"]:focus {
      outline: none;
      border-color: #007bff;
      box-shadow: 0 0 5px rgba(0, 123, 255, 0.2);
    }
    button {
      background: #007bff;
      color: #fff;
      border: none;
      padding: 12px 25px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 1em;
      font-weight: 500;
      transition: background 0.3s ease;
    }
    button:hover {
      background: #0056b3;
    }
    .generated-url {
      background: #e9ecef;
      padding: 15px;
      border: 1px solid #007bff;
      border-radius: 5px;
      margin-bottom: 30px;
      text-align: center;
      font-size: 1.1em;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
    }
    th, td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #dee2e6;
    }
    th {
      background: #007bff;
      color: #fff;
      font-weight: 500;
    }
    tr:nth-child(even) {
      background: #f8f9fa;
    }
    @media (max-width: 768px) {
      nav {
        flex-direction: column;
        padding: 10px;
      }
      nav .logo {
        margin-bottom: 10px;
      }
    }
  </style>
</head>
<body>
  <nav>
    <div class="logo">SMShortner</div>
    <form method="post" action="/user/logout">
      <button type="submit" class="logout-btn">Logout</button>
    </form>
  </nav>
  <div class="container">
    <h1>URL SHORTENER</h1>
    
    <% if (locals.id) { %>
      <div class="generated-url">
        <p>Generated URL - <a href="http://localhost:8000/url/<%= id %>" style="color:#007bff; text-decoration: none;">http://localhost:8000/url/<%= id %></a></p>
      </div>
    <% } %>
    
    <div>
      <form method="post" action="/url">
        <label for="url">Enter Your URL</label>
        <input type="text" name="url" id="url" placeholder="https://example.com">
        <button type="submit">Generate</button>
      </form>
    </div>
    
    <% if (locals.url) { %>
      <div>
        <table>
          <thead>
            <tr>
              <th>Sr. No.</th>
              <th>Short ID</th>
              <th>Redirect URL</th>
              <th>Clicks</th>
            </tr>
          </thead>
          <tbody>
            <% url.forEach((u, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><%= u.shortId %></td>
              <td><%= u.redirectUrl %></td>
              <td><%= u.visitedHistory.length %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
